      "title": "PlatformStats",
      "description": "Public aggregate metrics summary for landing page",
      "type": "object",
      "properties": {
        "studentsCount": { "type": "number" },
        "verifiedCompaniesCount": { "type": "number" },
        "activeInternshipsCount": { "type": "number" },
        "placementsCount": { "type": "number" },
        "demoRecordsIncluded": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentsCount", "verifiedCompaniesCount", "activeInternshipsCount", "placementsCount", "updatedAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "College administrator platform configuration",
      "type": "object",
      "properties": {
        "institutionName": { "type": "string", "maxLength": 180 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "institutionWebsite": { "type": "string", "maxLength": 300 },
        "institutionLinkedin": { "type": "string", "maxLength": 300 },
        "contactEmail": { "type": "string", "maxLength": 200 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "requireCompanyVerification": { "type": "boolean" },
        "requireInternshipApproval": { "type": "boolean" },
        "maxActiveApplicationsPerStudent": { "type": "number" },
        "allowWithdrawBeforeInterview": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["institutionName", "academicYear", "requireCompanyVerification", "requireInternshipApproval", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts with strict PII owner/admin isolation and immutable RBAC roles"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup table"
    },
    "/studentProfiles/{studentId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Private student profile with phone/email PII (owner + admin only)"
    },
    "/studentPublicProfiles/{studentId}": {
      "schema": { "$ref": "#/entities/StudentPublicProfile" },
      "description": "Recruiter-safe public academic portfolio"
    },
    "/careerPassports/{slug}": {
      "schema": { "$ref": "#/entities/CareerPassport" },
      "description": "Public shareable Career Passport (get allowed only when isPublic == true; PII strictly excluded)"
    },
    "/resumes/{resumeId}": {
      "schema": { "$ref": "#/entities/ResumeDocument" },
      "description": "Uploaded resume files with company sharing allowlist"
    },
    "/companyProfiles/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Private company profiles with admin-only verification status transitions"
    },
    "/companiesPublic/{companyId}": {
      "schema": { "$ref": "#/entities/CompanyPublicProfile" },
      "description": "Public directory cards for verified companies"
    },
    "/internships/{internshipId}": {
      "schema": { "$ref": "#/entities/Internship" },
      "description": "Internship opportunities; only approved published records are publicly discoverable"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Internship applications scoped to studentId, companyId, and admin"
    },
    "/interviews/{interviewId}": {
      "schema": { "$ref": "#/entities/Interview" },
      "description": "Scheduled interviews visible only to student, hosting company, and admin"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Persistent in-app notifications visible only to recipient or admin"
    },
    "/savedInternships/{savedId}": {
      "schema": { "$ref": "#/entities/SavedInternship" },
      "description": "Student bookmarked internships"
    },
    "/internshipProgress/{progressId}": {
      "schema": { "$ref": "#/entities/InternshipProgress" },
      "description": "Post-selection internship milestones, logs, and completion records"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Recruiter evaluation and final internship feedback"
    },
    "/activityLogs/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Append-only audit trail readable exclusively by administrators"
    },
    "/platformStats/{statId}": {
      "schema": { "$ref": "#/entities/PlatformStats" },
      "description": "Public aggregate metrics summary for landing page"
    },
    "/systemSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Administrator-controlled platform policy settings"
    }
  }
}
